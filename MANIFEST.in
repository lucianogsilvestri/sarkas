# Include documentation and configuration files
include README.md
include LICENSE
include CHANGELOG.rst
include pyproject.toml
include setup.py
include setup.cfg

# Include style files
recursive-include sarkas/mplstyles *.mplstyle
recursive-include sarkas/plotting *.mplstyle

# Exclude unnecessary files
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude *.so
global-exclude .DS_Store
prune .git
prune .github
prune docs/_build
prune build
prune dist